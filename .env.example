DATABASE_URL=postgresql+psycopg://dtu:dtu@postgres:5432/dtu_courses
# Optional dedicated URL for Alembic and long-running imports. In production,
# prefer Supabase Direct Connection or Session pooler (port 5432).
MIGRATION_DATABASE_URL=
API_KEY=replace-with-a-long-random-secret
DTU_BASE_URL=https://kurser.dtu.dk
DEFAULT_ACADEMIC_YEAR=2026-2027
IMPORT_REQUEST_DELAY=0.5
LOG_LEVEL=INFO
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEMPERATURE=0
SEMANTIC_RESOLUTION_ENABLED=true
SEMANTIC_RESOLUTION_MIN_CONFIDENCE=0.85
SEMANTIC_RESOLUTION_TIMEOUT=10
MCP_TOKEN=<generate-a-long-random-secret>
MCP_SERVER_URL=https://your-domain.vercel.app
